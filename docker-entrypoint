#!/bin/sh
# Author: Satish Gaikwad <satish@satishweb.com>
#
# shellcheck disable=SC3043
# The script runs with the busybox shell, it supports local.
set -e

# ---------------------------------------------------------------------------
# Logging helpers
# ---------------------------------------------------------------------------
__log()   { printf "| ENTRYPOINT: %s\n" "$*"; }
__warn()  { printf "| ENTRYPOINT: \033[0;33m%s\033[0m\n" "$*"; }
__error() { printf "| ENTRYPOINT: \033[0;31m%s\033[0m\n" "$*" >&2; }

SECRET_FILE_ENV_SUFFIX=_FILE
SECRET_DIR=/run/secrets

# Lets determine the OS flavor
OSF=$(cat /etc/os-release|grep -e '^ID=.*'|cut -d '=' -f 2)

printf "|---------------------------------------------------------------------------------------------\n";
printf "| Starting Unbound DNS Cache Server\n"

# ---------------------------------------------------------------------------
# Docker secrets
#
# Docker (compose) and Swarm expose secrets as files below /run/secrets and
# point at them through a "<NAME>_FILE" environment variable.  Every secret
# that is referenced this way is exported as a plain environment variable.
#
# Only the *names* of the variables are iterated over and the file contents
# are read verbatim.  This keeps secret values that contain whitespace or
# shell metacharacters intact.
#
# The secrets are loaded before the variables of the image are exported. Some
# of them end with _FILE as well and would be mistaken for a secret
# otherwise.
# ---------------------------------------------------------------------------
__secretNames() {
    env | sed -n "s/^\([A-Za-z_][A-Za-z0-9_]*\)${SECRET_FILE_ENV_SUFFIX}=.*/\1/p" | sort -u
}

__loadSecrets() {
    local names varName varFile value
    names="$(__secretNames)"

    for varName in ${names}; do
        varFile="$(printenv "${varName}${SECRET_FILE_ENV_SUFFIX}")"
        if [ ! -f "${varFile}" ]; then
            __warn "Secret file '${varFile}' for '${varName}' is missing, skipping."
            continue
        fi
        value="$(cat "${varFile}")"
        export "${varName}=${value}"
        __log "Exporting var: ${varName}"
    done
}

__log "Loading docker secrets if found..."
__loadSecrets

export SOURCE_StevenBlack_Unified_Hosts="${SOURCE_StevenBlack_Unified_Hosts:-true}"
export SOURCE_StevenBlack_Fakenews="${SOURCE_StevenBlack_Fakenews:-true}"
export SOURCE_StevenBlack_Gambling="${SOURCE_StevenBlack_Gambling:-true}"
export SOURCE_StevenBlack_Porn="${SOURCE_StevenBlack_Porn:-true}"
export SOURCE_TheGreatWall_Default="${SOURCE_TheGreatWall_Default:-true}"
export SOURCE_AdWars_Default="${SOURCE_AdWars_Default:-true}"
export SOURCE_VeleSila_Default="${SOURCE_VeleSila_Default:-true}"
export SOURCE_Tiuxo_Default="${SOURCE_Tiuxo_Default:-true}"

UNBOUND_CONFIG_DIR=/etc/unbound
export UNBOUND_CONFIG_FILE="${UNBOUND_CONFIG_FILE:-${UNBOUND_CONFIG_DIR}/unbound.conf}"
export UNBOUND_CONFIG_SAMPLE_FILE="${UNBOUND_CONFIG_SAMPLE_FILE:-/templates/unbound.sample.conf}"
export UNBOUND_ANCHOR_FILE="${UNBOUND_ANCHOR_FILE:-${UNBOUND_CONFIG_DIR}/keys/root.key}"
export UNBOUND_BLOCKED_HOSTS_FILE="${UNBOUND_BLOCKED_HOSTS_FILE:-${UNBOUND_CONFIG_DIR}/unbound.blocked.hosts}"
export UNBOUND_CUSTOM_HOSTS_FILE="${UNBOUND_CUSTOM_HOSTS_FILE:-${UNBOUND_CONFIG_DIR}/custom/custom.hosts}"
export ICANN_BUNDLE_FILE="${ICANN_BUNDLE_FILE:-${UNBOUND_CONFIG_DIR}/keys/icannbundle.pem}"

# DEBUG may be provided as a plain variable or through a secret.  A secret
# named "DEBUG" is also honoured for backwards compatibility.
if [ -z "${DEBUG}" ] && [ -f "${SECRET_DIR}/DEBUG" ]; then
    DEBUG="$(cat "${SECRET_DIR}/DEBUG")"
    export DEBUG
    __log "Exporting var: DEBUG"
fi

if [ "${DEBUG}" = "1" ] || [ "${DEBUG}" = "true" ]; then
    set -x
fi

# Lets copy default unbound config file
if [ ! -f "${UNBOUND_CONFIG_FILE}" ]; then
  cp -rf "${UNBOUND_CONFIG_SAMPLE_FILE}" "${UNBOUND_CONFIG_FILE}"
fi

# Lets create custom hosts file if not present
if [ ! -f "${UNBOUND_CUSTOM_HOSTS_FILE}" ]; then
  mkdir -p "${UNBOUND_CONFIG_DIR}/custom/"
  touch "${UNBOUND_CUSTOM_HOSTS_FILE}"
fi

# lets generate config file by replacing all variables inside of it.
TMP_FILE=/tmp/unbound.conf
cp "${UNBOUND_CONFIG_FILE}" "${TMP_FILE}"
envsubst < "${TMP_FILE}" > "${UNBOUND_CONFIG_FILE}"
rm "${TMP_FILE}"

# Lets create keys folder if does not exists
if [ ! -d "${UNBOUND_CONFIG_DIR}/keys" ]; then
  mkdir -p "${UNBOUND_CONFIG_DIR}/keys"
fi

# Lets download icannbundle.pem if it does not exists
if [ ! -f "${ICANN_BUNDLE_FILE}" ]; then
  curl https://data.iana.org/root-anchors/icannbundle.pem --output "${ICANN_BUNDLE_FILE}" >/dev/null 2>&1
  ln -s "${ICANN_BUNDLE_FILE}" "${UNBOUND_CONFIG_DIR}/icannbundle.pem"
  ln -s "${ICANN_BUNDLE_FILE}" /icannbundle.pem
fi

# Lets generate certificates if not created already
if [ ! -f "${UNBOUND_CONFIG_DIR}/unbound_control.pem" ] || [ ! -f "${UNBOUND_CONFIG_DIR}/unbound_server.pem" ]; then
  __log "Setting up unbound certificates..."
  unbound-control-setup 2>&1 | sed 's/^/| ENTRYPOINT: Unbound: /g'
fi

# Lets create or validate root anchor key
unbound-anchor -a "${UNBOUND_ANCHOR_FILE}" || echo
# We had to add echo to avoid exit due to unbound-anchor command failure.
# We have set -e set for this script

# Lets set correct permissions for files used by unbound
chown -Rf unbound:unbound "${UNBOUND_CONFIG_DIR}" "${UNBOUND_CONFIG_DIR}/keys" 2>/dev/null || \
  __warn "Could not change the owner of ${UNBOUND_CONFIG_DIR}, continuing."
chmod 644 "${UNBOUND_CONFIG_DIR}"/*.conf

# Setup blocked hosts file if it does not exists
if [ ! -f "${UNBOUND_BLOCKED_HOSTS_FILE}" ]; then
  /bin/sh /scripts/update_blocked_hosts.sh "${UNBOUND_BLOCKED_HOSTS_FILE}" no-reload
fi

__log "Starting supervisord (which starts and monitors cron and unbound)"
printf "|---------------------------------------------------------------------------------------------\n";

# Lets create cron script for updating host daily
if [ "$OSF" = "ubuntu" ]; then
  rm -rf /etc/cron.daily/*
  CRON_FILE=/etc/cron.daily/updatehosts
elif [ "$OSF" = "alpine" ]; then
  CRON_FILE=/etc/periodic/daily/updatehosts
else
  echo "Error: We support only alpine and ubuntu flavors right now"
  sleep 1000000000
fi

# The cron job runs in its own shell, the variables of the block list sources
# and the white list are written into it so the daily update uses the same
# settings as the container.
{
  printf "#!/bin/bash\nPATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n"
  printf 'export SOURCE_StevenBlack_Unified_Hosts="%s"\n' "${SOURCE_StevenBlack_Unified_Hosts}"
  printf 'export SOURCE_StevenBlack_Fakenews="%s"\n' "${SOURCE_StevenBlack_Fakenews}"
  printf 'export SOURCE_StevenBlack_Gambling="%s"\n' "${SOURCE_StevenBlack_Gambling}"
  printf 'export SOURCE_StevenBlack_Porn="%s"\n' "${SOURCE_StevenBlack_Porn}"
  printf 'export SOURCE_TheGreatWall_Default="%s"\n' "${SOURCE_TheGreatWall_Default}"
  printf 'export SOURCE_AdWars_Default="%s"\n' "${SOURCE_AdWars_Default}"
  printf 'export SOURCE_VeleSila_Default="%s"\n' "${SOURCE_VeleSila_Default}"
  printf 'export SOURCE_Tiuxo_Default="%s"\n' "${SOURCE_Tiuxo_Default}"
  printf 'export DOMAIN_WHITELIST="%s"\n' "${DOMAIN_WHITELIST:-}"
  printf '. /scripts/update_blocked_hosts.sh %s\n' "${UNBOUND_BLOCKED_HOSTS_FILE}"
} > "${CRON_FILE}"
chmod +x "${CRON_FILE}"

# Check if app-config is present
if [ -f /app-config ]; then
    # We expect that app-config handles the launch of app command
    __log "Executing app-config..."
    # shellcheck disable=SC1091,SC2240
    . /app-config "$@"
else
    # Let default CMD run if app-config is missing
    __log "app-config was not available, running given parameters or default CMD..."
    if [ $# -eq 0 ]; then
        __error "No command given, nothing to start."
        exit 1
    fi
    exec "$@"
fi
